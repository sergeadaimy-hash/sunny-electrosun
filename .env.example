# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Owner notifications
OWNER_WHATSAPP=
OWNER_EMAIL=

# Specialist click-to-chat link appended to escalation holding replies.
# Phone number in international format, digits only, no plus sign.
# When set, customers who hit a HOT lead or silent_query escalation get
# a wa.me link to reach this number directly. Leave empty to disable.
SPECIALIST_DIRECT_LINK=

# Public base URL used in owner escalation alerts to deep-link the owner
# straight to the relevant conversation in the admin inbox.
# Form: <PUBLIC_BASE_URL>/admin#conv=<conversation_id>.
# No trailing slash. Defaults to the Railway production URL when unset.
PUBLIC_BASE_URL=

# Email fallback (SMTP)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Server
PORT=3000

# Dashboard API
API_KEY=

# Inbox-only team login. When all three are set, a team member can sign in at
# /admin (or /inbox) with INBOX_USER + INBOX_PASSWORD and is locked to the Inbox
# tab only. The server issues INBOX_API_KEY to that account and refuses every
# non-inbox endpoint (contacts, warehouse, prompts, brain, owner-chat) with 403.
# INBOX_API_KEY must be a different random secret, NOT the master API_KEY above.
# Leave blank to disable the inbox-only login entirely.
INBOX_USER=
INBOX_PASSWORD=
INBOX_API_KEY=

# Cost guardrail (USD per day)
DAILY_LLM_BUDGET_USD=5

# Set to "false" on cloud PaaS (Railway, Fly.io, etc.) where filesystem is
# ephemeral. Disables logs/sunny.log file writes and the daily DB snapshot,
# leaving only stdout/stderr (which the platform captures). Default is to
# write to file (suitable for laptop and Mac Mini).
LOG_TO_FILE=true

# Path to the SQLite database file. Defaults to db/sunny.db inside the repo
# (suitable for laptop and Mac Mini). On cloud PaaS, point this at the
# mounted persistent volume, e.g. DB_PATH=/data/sunny.db on Railway.
DB_PATH=

# Directory for downloaded customer media (WhatsApp images). Defaults to
# <DB_PATH dirname>/media so it sits next to the SQLite file on the same
# volume. Override only if you want media stored separately.
MEDIA_DIR=

# Nightly self-improvement audit (Phase 1). Off by default.
ENABLE_NIGHTLY_AUDIT=false
# Audit model (cheap; must be a prefix the cost tracker knows: claude-sonnet-4-6).
MODEL_AUDIT=claude-sonnet-5
# Max conversations audited per nightly run (cost guard).
AUDIT_MAX_CONVERSATIONS=60
# Who receives the nightly "proposals waiting" ping. Defaults to OWNER_WHATSAPP.
# Set to a developer number (digits only, no plus) while testing so the owner is not pinged.
AUDIT_PING_WHATSAPP=

# --- Sales Manager follow-up check-in (2026-07-26) ---
# A few hours after Sunny hands a customer to the Sales Manager, Sunny asks the
# customer whether it was sorted and if they need anything else. Runs on the
# always-on */5 cron (works even under DISABLE_NOTIFICATIONS=true).
# Delay from handoff to check-in, in minutes (default 180 = 3h).
SALES_FOLLOWUP_DELAY_MINUTES=180
# Africa/Lagos hour the check-in may start in the morning (inclusive, default 8).
SALES_FOLLOWUP_SEND_START=8
# Africa/Lagos hour the check-in stops for the night (exclusive, default 21). Quiet 21:00-08:00.
SALES_FOLLOWUP_SEND_END=21
# A due follow-up older than this is dropped unsent, so it never lands outside the
# WhatsApp 24h window (default 1440 = 24h).
SALES_FOLLOWUP_MAX_AGE_MINUTES=1440
# Max check-ins sent per cron run (default 20).
SALES_FOLLOWUP_PER_RUN_CAP=20
# Kill switch for the whole feature (default false).
DISABLE_SALES_FOLLOWUP=false
