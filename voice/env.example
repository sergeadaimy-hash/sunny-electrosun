# Meta WhatsApp Cloud API (same WABA + number as the Node service)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1143874562134501

# Only needed in DIRECT debug mode (Meta webhook pointed straight at this
# server). Leave empty in production forwarded mode.
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=

# Shared secret between Sunny (Node) and this sidecar. Set the SAME value as
# VOICE_SERVICE_SECRET on the Node service. Empty = header check disabled.
VOICE_SERVICE_SECRET=

# AI services
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=

# Where call transcripts are posted at call end (Sunny's Node service).
SUNNY_BASE_URL=https://sunny-electrosun-production.up.railway.app

# Optional overrides
MODEL_VOICE=claude-sonnet-4-6
CARTESIA_VOICE_ID=
LOG_LEVEL=INFO
PORT=7860
